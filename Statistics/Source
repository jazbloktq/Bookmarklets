        <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:${col.stroke};"></span>
        <span id="__st-tab-label-${ds.id}__" contenteditable="${isActive?'true':'false'}" onblur="window.__stRenameDs__(${ds.id},this.textContent)" style="outline:none;cursor:${isActive?'text':'pointer'};min-width:40px;">${escHtml(ds.label)}</span>
        ${modeIcon ? `<span style="font-size:10px;opacity:0.6;">${modeIcon}</span>` : ''}
        ${datasets.length > 1 ? `<span onclick="event.stopPropagation();window.__stRemoveDs__(${ds.id})" style="margin-left:2px;color:#bbb;font-size:13px;cursor:pointer;" title="Remove">✕</span>` : ''}
      </div>`;
    });
    const hasMulti = datasets.filter(d => d.stats).length >= 2;
    const isCmpActive = activeTab === -1;
    html += `<div onclick="window.__stSelectTab__(-1)" style="padding:5px 10px;border-radius:6px;cursor:pointer;font-size:12px;font-weight:500;border:1.5px solid ${isCmpActive?'#7a5abf':'#ddd'};background:${isCmpActive?'#f5eeff':'#f7f7f7'};color:${isCmpActive?'#7a5abf':hasMulti?'#666':'#ccc'};transition:all .12s;">${hasMulti?'⊕ Compare':'⊕ Compare (need 2+)'}</div>`;
    tabsEl.innerHTML = html;
  }

  /* ── Input mode tabs ──────────────────────────────────────── */
  function renderInputModes() {
    const wrap = document.getElementById("__st-input-mode-tabs__");
    if (!wrap) return;
    const ds = getDS();
    if (!ds) { wrap.innerHTML = ''; return; }
    const modes = [
      { id: 'raw', label: 'Raw numbers' },
      { id: 'hist', label: 'Frequency table' },
      { id: 'boxplot', label: 'Box plot input' },
    ];
    wrap.innerHTML = modes.map(m =>
      `<button onclick="window.__stSetInputMode__('${m.id}')" style="padding:5px 12px;border-radius:6px;font-size:12px;font-weight:500;cursor:pointer;border:1.5px solid ${ds.inputMode===m.id?'#1a5abf':'#ddd'};background:${ds.inputMode===m.id?'#e8f0fe':'#f7f7f7'};color:${ds.inputMode===m.id?'#1a5abf':'#666'};">${m.label}</button>`
    ).join('');
  }

  /* ── Frequency table rows state ────────────────────────────── */
  // Each dataset stores its hist rows separately
  // We keep them in ds.histRows = [{id, val, freq}]
  let _hid = 0;
  function ensureHistRows(ds) {
    if (!ds.histRows) ds.histRows = [{ id: _hid++, val: '', freq: '' }, { id: _hid++, val: '', freq: '' }];
  }
  function ensureBPState(ds) {
    if (!ds.bpState) ds.bpState = { min:'', q1:'', med:'', q3:'', max:'', n:'', outliers:'' };
  }

  function renderDatasetInputArea() {
    const wrap = document.getElementById("__st-dataset-input-wrap__");
    if (!wrap) return;
    if (activeTab === -1) {
      wrap.innerHTML = '<div style="padding:8px 10px;background:#f5f0ff;border:1px solid #ddd;border-radius:8px;font-size:12px;color:#7a5abf;">Select a dataset tab above to edit data.</div>';
      return;
    }
    const ds = datasets[activeTab];
    if (!ds) return;
    const col = DATASET_COLORS[datasets.indexOf(ds) % DATASET_COLORS.length];

    if (ds.inputMode === 'raw') {
      wrap.innerHTML = `<div style="position:relative;">
        <div style="position:absolute;left:10px;top:9px;font-size:10px;font-weight:600;color:${col.stroke};letter-spacing:.04em;text-transform:uppercase;z-index:1;">${escHtml(ds.label)}</div>
        <textarea id="__st-input__" rows="2" style="width:100%;padding:9px 12px;padding-top:24px;border:1.5px solid ${col.stroke};border-radius:8px;font-size:13px;font-family:monospace;outline:none;color:#111;background:#fff;resize:none;box-sizing:border-box;" placeholder="Enter numbers separated by commas, e.g.  3, 7, 12, 5, 9">${escHtml(ds.raw)}</textarea>
      </div>`;
      const ta = document.getElementById("__st-input__");
      if (ta) {
        ta.addEventListener("keydown", e => { if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); run(); } });
        ta.addEventListener("input", () => { if (datasets[activeTab]) datasets[activeTab].raw = ta.value; });
      }

    } else if (ds.inputMode === 'hist') {
      ensureHistRows(ds);
      wrap.innerHTML = `
        <div style="font-size:11px;color:#666;margin-bottom:8px;">Enter each unique value and how many times it appears.</div>
        <div style="display:grid;grid-template-columns:1fr 1fr 28px;gap:6px;margin-bottom:4px;padding:0 2px;">
          <span style="font-size:11px;color:#888;">Value</span>
          <span style="font-size:11px;color:#888;">Frequency (count)</span>
          <span></span>
        </div>
        <div id="__st-hist-rows__"></div>
        <button onclick="window.__stAddHistRow__()" style="width:100%;padding:6px;margin-top:4px;border:1.5px dashed #ddd;border-radius:8px;background:transparent;color:#aaa;font-size:12px;cursor:pointer;">+ Add value</button>
        <div id="__st-hist-preview__" style="margin-top:6px;font-size:11px;color:#888;min-height:16px;"></div>
      `;
      renderHistRowsDOM(ds);

    } else if (ds.inputMode === 'boxplot') {
      ensureBPState(ds);
      const bp = ds.bpState;
      wrap.innerHTML = `
        <div style="font-size:11px;color:#666;margin-bottom:10px;">Enter the five-number summary from a box plot. All derived statistics will be calculated.</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:8px;">
          ${bpField('bp-min','Minimum',bp.min)}
          ${bpField('bp-q1','Q1 (lower quartile)',bp.q1)}
          ${bpField('bp-med','Median (Q2)',bp.med)}
          ${bpField('bp-q3','Q3 (upper quartile)',bp.q3)}
          ${bpField('bp-max','Maximum',bp.max)}
          ${bpField('bp-n','n (sample size, optional)',bp.n)}
        </div>
        <div style="margin-bottom:6px;">
          <div style="font-size:11px;color:#888;margin-bottom:4px;">Outliers (optional, comma-separated)</div>
          <input id="bp-outliers" type="text" value="${escHtml(bp.outliers||'')}" placeholder="e.g. 5, 120, 130" oninput="window.__stSaveBP__()" style="width:100%;padding:7px 10px;border:1.5px solid #ddd;border-radius:8px;font-size:13px;font-family:monospace;outline:none;box-sizing:border-box;">
        </div>
        <div id="bp-preview" style="font-size:11px;color:#888;padding:6px 10px;background:#f7f7f7;border-radius:7px;min-height:20px;"></div>
      `;
      updateBPPreview(ds);
      // attach listeners
      ['bp-min','bp-q1','bp-med','bp-q3','bp-max','bp-n'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.addEventListener('input', () => { window.__stSaveBP__(); });
      });
    }
  }

  function bpField(id, label, val) {
    return `<div>
      <div style="font-size:11px;color:#888;margin-bottom:4px;">${label}</div>
      <input id="${id}" type="number" value="${val||''}" oninput="window.__stSaveBP__()" style="width:100%;padding:7px 10px;border:1.5px solid #ddd;border-radius:8px;font-size:13px;font-family:monospace;outline:none;box-sizing:border-box;" placeholder="">
    </div>`;
  }

  window.__stSaveBP__ = function() {
    const ds = getDS();
    if (!ds || ds.inputMode !== 'boxplot') return;
    ensureBPState(ds);
    ds.bpState.min = document.getElementById('bp-min')?.value || '';
    ds.bpState.q1  = document.getElementById('bp-q1')?.value || '';
    ds.bpState.med = document.getElementById('bp-med')?.value || '';
    ds.bpState.q3  = document.getElementById('bp-q3')?.value || '';
    ds.bpState.max = document.getElementById('bp-max')?.value || '';
    ds.bpState.n   = document.getElementById('bp-n')?.value || '';
    ds.bpState.outliers = document.getElementById('bp-outliers')?.value || '';
    updateBPPreview(ds);
  };

  function updateBPPreview(ds) {
    const pre = document.getElementById('bp-preview');
    if (!pre || !ds.bpState) return;
    const { min, q1, med, q3, max } = ds.bpState;
    const parts = [];
    if (min!='') parts.push('Min='+min);
    if (q1!='') parts.push('Q1='+q1);
    if (med!='') parts.push('Median='+med);
    if (q3!='') parts.push('Q3='+q3);
    if (max!='') parts.push('Max='+max);
    if (q1!==''&&q3!=='') parts.push('IQR='+(parseFloat(q3)-parseFloat(q1)));
    if (min!==''&&max!=='') parts.push('Range='+(parseFloat(max)-parseFloat(min)));
    pre.textContent = parts.join(' · ');
  }

  function renderHistRowsDOM(ds) {
    const container = document.getElementById("__st-hist-rows__");
    if (!container) return;
    container.innerHTML = ds.histRows.map(r => `
      <div style="display:grid;grid-template-columns:1fr 1fr 28px;gap:6px;margin-bottom:5px;" id="hrow-${r.id}">
        <input id="hv-${r.id}" type="number" value="${r.val}" placeholder="Value" oninput="window.__stHistInput__(${r.id},'val',this.value)"
          style="padding:6px 10px;border:1.5px solid #ddd;border-radius:7px;font-size:13px;font-family:monospace;outline:none;width:100%;box-sizing:border-box;">
        <input id="hf-${r.id}" type="number" value="${r.freq}" placeholder="Count" min="1" oninput="window.__stHistInput__(${r.id},'freq',this.value)"
          style="padding:6px 10px;border:1.5px solid #ddd;border-radius:7px;font-size:13px;font-family:monospace;outline:none;width:100%;box-sizing:border-box;">
        <button onclick="window.__stRemoveHistRow__(${r.id})" style="padding:0;width:28px;border:1.5px solid #eee;border-radius:7px;background:#fff;color:#ccc;cursor:pointer;font-size:14px;line-height:1;" title="Remove">✕</button>
      </div>
    `).join('');
    updateHistPreview(ds);
  }

  window.__stHistInput__ = function(id, field, val) {
    const ds = getDS();
    if (!ds) return;
    const row = ds.histRows.find(r => r.id === id);
    if (row) { row[field] = val; updateHistPreview(ds); }
  };

  window.__stAddHistRow__ = function() {
    const ds = getDS();
    if (!ds) return;
    ensureHistRows(ds);
    ds.histRows.push({ id: _hid++, val: '', freq: '' });
    renderHistRowsDOM(ds);
    const last = ds.histRows[ds.histRows.length - 1];
    document.getElementById('hv-'+last.id)?.focus();
  };

  window.__stRemoveHistRow__ = function(id) {
    const ds = getDS();
    if (!ds || ds.histRows.length <= 1) return;
    ds.histRows = ds.histRows.filter(r => r.id !== id);
    renderHistRowsDOM(ds);
  };

  function getHistNums(ds) {
    const nums = [];
    let hasError = false;
    (ds.histRows || []).forEach(r => {
      const v = parseFloat(r.val), fr = parseInt(r.freq);
      if (!isNaN(v) && !isNaN(fr) && fr > 0) {
        for (let i = 0; i < fr; i++) nums.push(v);
      } else if (r.val !== '' || r.freq !== '') {
        hasError = true;
      }
    });
    return { nums, hasError };
  }

  function updateHistPreview(ds) {
    const pre = document.getElementById('__st-hist-preview__');
    if (!pre) return;
    const { nums } = getHistNums(ds);
    pre.textContent = nums.length ? `Total n = ${nums.length} · Values: ${nums.slice(0,14).join(', ')}${nums.length>14?'...':''}` : '';
  }

  /* ── Run ───────────────────────────────────────────────────── */
  function run() {
    if (activeTab === -1) return;
    const ds = datasets[activeTab];
    if (!ds) return;
    const errEl = document.getElementById("__st-err__");
    if (errEl) errEl.textContent = "";

    if (ds.inputMode === 'raw') {
      const raw = (document.getElementById("__st-input__") || {}).value || ds.raw;
      ds.raw = raw;
      const nums = raw.split(/[\s,]+/).map(s=>s.trim()).filter(s=>s!=="").map(Number);
      if (nums.length < 2) { if (errEl) errEl.textContent = "Please enter at least 2 numbers."; return; }
      if (nums.some(isNaN)) { if (errEl) errEl.textContent = "One or more values are not valid numbers."; return; }
      ds.stats = computeStats(nums);
      pushHistory(ds.label + ": " + raw.trim().slice(0, 50), ds.stats);
      renderDatasetTabs();
      renderActiveTab();

    } else if (ds.inputMode === 'hist') {
      const { nums, hasError } = getHistNums(ds);
      if (nums.length < 2) { if (errEl) errEl.textContent = "Please enter at least 2 values with frequencies."; return; }
      if (hasError) { if (errEl) errEl.textContent = "Some rows have incomplete or invalid data — check values and counts."; return; }
      ds.stats = computeStats(nums);
      const summary = ds.histRows.filter(r=>r.val!==''&&r.freq!=='').map(r=>`${r.val}×${r.freq}`).join(', ');
      pushHistory(ds.label + " [freq]: " + summary.slice(0,50), ds.stats);
      renderDatasetTabs();
      renderActiveTab();

    } else if (ds.inputMode === 'boxplot') {
      window.__stSaveBP__();
      const bp = ds.bpState;
      const min = parseFloat(bp.min), q1 = parseFloat(bp.q1), med = parseFloat(bp.med),
            q3 = parseFloat(bp.q3), max = parseFloat(bp.max);
      if ([min,q1,med,q3,max].some(isNaN)) { if (errEl) errEl.textContent = "Please enter all five values: Min, Q1, Median, Q3, Max."; return; }
      if (!(min <= q1 && q1 <= med && med <= q3 && q3 <= max)) { if (errEl) errEl.textContent = "Values must be in order: Min ≤ Q1 ≤ Median ≤ Q3 ≤ Max."; return; }
      const outlierList = bp.outliers ? bp.outliers.split(/[\s,]+/).map(Number).filter(v=>!isNaN(v)) : [];
      const n = parseInt(bp.n) || null;
      ds.bpResult = { min, q1, med, q3, max, n, outlierList };
      ds.stats = { n: n||'n/a', mean: '~', sampleStdDev: '~', q1, q2: med, q3 }; // stub for history
      history.unshift({ label: ds.label+" [box plot]: "+[min,q1,med,q3,max].join(', '), result: "IQR="+(q3-q1)+"  R="+(max-min), time: new Date().toLocaleTimeString() });
      if (history.length > MAX_HIST) history.pop();
      renderHistory();
      renderDatasetTabs();
      renderActiveTab();
    }
  }

  /* ── Global actions ────────────────────────────────────────── */
  window.__stSelectTab__ = function(idx) {
    activeTab = idx;
    renderDatasetTabs();
    renderInputModes();
    renderDatasetInputArea();
    renderActiveTab();
  };

  window.__stSetInputMode__ = function(mode) {
    const ds = getDS();
    if (!ds) return;
    ds.inputMode = mode;
    ds.stats = null;
    ds.bpResult = null;
    renderInputModes();
    renderDatasetInputArea();
    document.getElementById("__st-body__").innerHTML = '<div style="padding:24px 0;text-align:center;color:#ccc;font-size:13px;">Enter data above and click Calculate.</div>';
    const errEl = document.getElementById("__st-err__");
    if (errEl) errEl.textContent = "";
  };

  window.__stRenameDs__ = function(id, newLabel) {
    const ds = datasets.find(d => d.id === id);
    if (ds && newLabel.trim()) { ds.label = newLabel.trim().slice(0,20); renderDatasetTabs(); }
  };

  window.__stRemoveDs__ = function(id) {
    const idx = datasets.findIndex(d => d.id === id);
    if (idx === -1 || datasets.length <= 1) return;
    datasets.splice(idx, 1);
    activeTab = Math.min(activeTab, datasets.length - 1);
    if (activeTab < 0) activeTab = 0;
    renderDatasetTabs();
    renderInputModes();
    renderDatasetInputArea();
    renderActiveTab();
  };

  /* ── renderActiveTab ──────────────────────────────────────── */
  function renderActiveTab() {
    const body = document.getElementById("__st-body__");
    if (!body) return;

    if (activeTab === -1) {
      body.innerHTML = renderComparison();
      const valid = datasets.filter(d => d.stats && d.stats.sorted); // only datasets with full stats
      const colors = valid.map((d, i) => ({ ...DATASET_COLORS[i % DATASET_COLORS.length], name: d.label }));
      if (valid.length >= 2) {
        const bpH = Math.max(90, valid.length * 55 + 65);
        requestAnimationFrame(() => {
          const bp = makeCanvas("__st-cmp-box__", bpH);
          if (bp) drawBoxPlot(bp.ctx, bp.W, bp.H, valid.map(d => d.stats), colors);
          const kd = makeCanvas("__st-cmp-kde__", 260);
          if (kd) drawKDE(kd.ctx, kd.W, kd.H, valid.map(d => d.stats), colors);
        });
      }
      return;
    }

    const ds = datasets[activeTab];
    if (!ds) return;
    const colIdx = datasets.indexOf(ds);
    const col = { ...DATASET_COLORS[colIdx % DATASET_COLORS.length], name: ds.label };

    if (ds.inputMode === 'boxplot') {
      if (!ds.bpResult) {
        body.innerHTML = '<div style="padding:24px 0;text-align:center;color:#ccc;font-size:13px;">Fill in the box plot values above and click Calculate.</div>';
        return;
      }
      body.innerHTML = renderBPSummary(ds.bpResult, colIdx);
      requestAnimationFrame(() => {
        const cv = makeCanvas("__st-bp-canvas__", 140);
        if (cv) drawSummaryBoxPlot(cv.ctx, cv.W, cv.H, ds.bpResult, col);
      });
      return;
    }

    if (!ds.stats) {
      body.innerHTML = '<div style="padding:24px 0;text-align:center;color:#ccc;font-size:13px;">Enter numbers above and click Calculate.</div>';
      return;
    }

    body.innerHTML = renderSingle(ds.stats, colIdx);
    requestAnimationFrame(() => {
      if (ds.inputMode === 'hist') drawHistogram("__st-histchart__", ds.stats, col);
      const bp = makeCanvas("__st-boxplot__", 130);
      if (bp) drawBoxPlot(bp.ctx, bp.W, bp.H, [ds.stats], [col]);
      const kd = makeCanvas("__st-canvas__", 260);
      if (kd) drawKDE(kd.ctx, kd.W, kd.H, [ds.stats], [col]);
    });
  }

  /* ── DOM build ─────────────────────────────────────────────── */
  const overlay = document.createElement("div");
  overlay.id = TOOL_ID;
  overlay.style.cssText = "position:fixed;top:20px;right:20px;z-index:999999;width:600px;max-width:calc(100vw - 40px);background:#fff;color:#111;border:1px solid #ddd;border-radius:14px;box-shadow:0 8px 40px rgba(0,0,0,0.18);font-family:system-ui,sans-serif;font-size:14px;overflow:hidden;max-height:calc(100vh - 40px);display:flex;flex-direction:column;";

  const styleEl = document.createElement("style");
  styleEl.textContent = [
    "#__stats-tool__ *{box-sizing:border-box;}",
    "#__st-input__{width:100%;padding:9px 12px;border:1.5px solid #bbb;border-radius:8px;font-size:14px;font-family:monospace;outline:none;color:#111;background:#fff;transition:border-color 0.15s;resize:none;}",
    "#__st-input__:focus{border-color:#1a5abf;}",
    "#__st-go__{width:100%;padding:10px;background:#1a1a1a;color:#fff;border:none;border-radius:8px;font-size:14px;font-weight:500;cursor:pointer;letter-spacing:0.02em;transition:background 0.15s;}",
    "#__st-go__:hover{background:#333;}",
    ".__st-card__{background:#f5f7fb;border:1px solid #e4e8f0;border-radius:8px;padding:8px 12px;min-width:0;}",
    ".__st-card-label__{font-size:10px;color:#888;text-transform:uppercase;letter-spacing:.06em;margin-bottom:3px;}",
    ".__st-card-value__{font-size:17px;font-weight:600;color:#111;font-family:Georgia,serif;word-break:break-all;}",
    ".__st-card-value__.sm{font-size:13px;}",
    ".__st-section__{font-size:10px;color:#bbb;text-transform:uppercase;letter-spacing:.07em;margin:14px 0 7px;}",
    ".__st-out-badge__{font-size:10px;font-family:monospace;background:#fff0f0;color:#c00;border:1px solid #f5bbbb;border-radius:3px;padding:1px 5px;}",
    ".__st-z-badge__{font-size:10px;font-family:monospace;background:#fff7e0;color:#805500;border:1px solid #f5dfa0;border-radius:3px;padding:1px 5px;}",
    ".__st-scroll__{overflow-y:auto;flex:1;padding:0 16px 16px;}",
    "table{width:100%;border-collapse:collapse;font-size:12px;}",
    "th{text-align:left;padding:5px 8px;border-bottom:1px solid #eee;color:#888;font-weight:500;font-size:11px;white-space:nowrap;}",
    "td{padding:5px 8px;border-bottom:1px solid #f3f3f3;color:#333;white-space:nowrap;font-family:monospace;}",
    "tr:last-child td{border-bottom:none;}",
    "tr.outlier-row td{background:#fff8f8;color:#c00;}",
  ].join("");
  overlay.appendChild(styleEl);

  overlay.innerHTML += `
  <div id="__st-hdr__" style="display:flex;align-items:center;justify-content:space-between;padding:12px 16px;background:#f7f7f7;border-bottom:1px solid #e8e8e8;cursor:move;user-select:none;flex-shrink:0;">
    <div style="display:flex;align-items:center;gap:10px;">
      <span style="font-weight:700;font-size:15px;letter-spacing:-0.3px;">Statistics Tool</span>
      <span style="font-size:11px;color:#aaa;font-style:italic;">v6 · multi-dataset · freq table · box plot input</span>
    </div>
    <button id="__st-x__" style="background:none;border:none;font-size:18px;cursor:pointer;padding:0 4px;color:#666;line-height:1;">✕</button>
  </div>
  <div style="padding:14px 16px 12px;border-bottom:1px solid #eee;flex-shrink:0;">
    <div id="__st-dataset-tabs__" style="display:flex;gap:4px;margin-bottom:8px;flex-wrap:wrap;align-items:center;"></div>
    <div id="__st-input-mode-tabs__" style="display:flex;gap:4px;margin-bottom:10px;flex-wrap:wrap;"></div>
    <div id="__st-dataset-input-wrap__"></div>
    <div style="display:flex;gap:8px;margin-top:8px;align-items:center;flex-wrap:wrap;">
      <button id="__st-go__" style="flex:1;min-width:120px;margin-bottom:0;">Calculate</button>
      <button id="__st-clear__" style="padding:10px 16px;border:1px solid #ddd;border-radius:8px;background:#fff;color:#555;font-size:13px;cursor:pointer;white-space:nowrap;">Clear</button>
      <button id="__st-add-ds__" style="padding:10px 14px;border:1px solid #1a5abf;border-radius:8px;background:#f0f4ff;color:#1a5abf;font-size:13px;cursor:pointer;white-space:nowrap;font-weight:500;">+ Dataset</button>
    </div>
    <div id="__st-err__" style="min-height:16px;margin-top:6px;font-size:12px;color:#c00;"></div>
    <div style="margin-top:8px;display:flex;gap:5px;flex-wrap:wrap;align-items:center;" id="__st-examples__">
      <span style="font-size:10px;color:#bbb;">Examples:</span>
    </div>
  </div>
  <div class="__st-scroll__" id="__st-body__">
    <div style="padding:24px 0;text-align:center;color:#ccc;font-size:13px;">Enter numbers above to see statistics</div>
  </div>
  <div style="border-top:1px solid #eee;padding:10px 16px 12px;flex-shrink:0;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
      <span style="font-size:10px;color:#bbb;text-transform:uppercase;letter-spacing:.07em;">History</span>
      <button onclick="window.__st_clearHistory&&window.__st_clearHistory()" style="font-size:11px;color:#bbb;background:none;border:none;cursor:pointer;padding:0;">Clear</button>
    </div>
    <div id="__st-hist-list__" style="max-height:80px;overflow-y:auto;"><span style="color:#bbb;font-size:12px;">No history yet</span></div>
  </div>`;

  document.body.appendChild(overlay);

  // Examples
  const examples = [
    { label: "Symmetric", val: "2, 4, 6, 4, 2, 6, 4, 5, 3, 4" },
    { label: "Right skew", val: "1, 2, 2, 3, 3, 3, 10, 15, 20, 25" },
    { label: "With outliers", val: "5, 6, 7, 8, 6, 7, 6, 5, 100, 4" },
    { label: "Class test", val: "45, 67, 72, 55, 88, 91, 60, 73, 66, 79, 82, 50" },
  ];
  const exDiv = document.getElementById("__st-examples__");
  if (exDiv) examples.forEach(ex => {
    const chip = document.createElement("button");
    chip.textContent = ex.label;
    chip.style.cssText = "padding:3px 10px;font-size:11px;border:1px solid #ddd;border-radius:999px;cursor:pointer;color:#555;background:#f5f5f5;";
    chip.onmouseover = () => chip.style.background = "#e8e8e8";
    chip.onmouseout  = () => chip.style.background = "#f5f5f5";
    chip.onclick = () => {
      const ds = getDS();
      if (ds && ds.inputMode === 'raw') {
        ds.raw = ex.val;
        renderDatasetInputArea();
      }
    };
    exDiv.appendChild(chip);
  });

  document.getElementById("__st-go__").onclick = run;
  document.getElementById("__st-clear__").onclick = () => {
    const ds = getDS();
    if (ds) {
      ds.raw = ""; ds.stats = null; ds.bpResult = null;
      if (ds.histRows) ds.histRows = [{ id: _hid++, val:'', freq:'' }, { id: _hid++, val:'', freq:'' }];
      if (ds.bpState) ds.bpState = { min:'', q1:'', med:'', q3:'', max:'', n:'', outliers:'' };
    }
    renderDatasetInputArea();
    renderDatasetTabs();
    const errEl = document.getElementById("__st-err__");
    if (errEl) errEl.textContent = "";
    document.getElementById("__st-body__").innerHTML = '<div style="padding:24px 0;text-align:center;color:#ccc;font-size:13px;">Enter numbers above to see statistics</div>';
  };
  document.getElementById("__st-add-ds__").onclick = () => {
    if (datasets.length >= 4) { alert("Maximum 4 datasets supported."); return; }
    const col = DATASET_COLORS[datasets.length];
    const ds = { id: nextId++, label: col.name, raw: "", stats: null, inputMode: "raw" };
    datasets.push(ds);
    activeTab = datasets.length - 1;
    renderDatasetTabs();
    renderInputModes();
    renderDatasetInputArea();
    renderActiveTab();
  };

  // Drag
  let dragging=false,dx=0,dy=0;
  document.getElementById("__st-hdr__").addEventListener("mousedown",e=>{
    dragging=true;
    const r=overlay.getBoundingClientRect();
    dx=e.clientX-r.left; dy=e.clientY-r.top;
    overlay.style.transition="none";
  });
  document.addEventListener("mousemove",e=>{
    if(!dragging)return;
    overlay.style.left=(e.clientX-dx)+"px";
    overlay.style.top=(e.clientY-dy)+"px";
    overlay.style.right="auto";
  });
  document.addEventListener("mouseup",()=>{dragging=false;});
  document.getElementById("__st-x__").onclick=()=>overlay.remove();
  window.__st_clearHistory=()=>{history=[];renderHistory();};

  // Init
  datasets[0].inputMode = 'raw';
  renderDatasetTabs();
  renderInputModes();
  renderDatasetInputArea();
})();
