/* ============================================================
   STATISTICS TOOL v5 — paste into browser console
   Paste once to open, paste again to close.
   Multi-dataset support · Comparison panel · Stem & Leaf plots
   ============================================================ */

(function () {
  const TOOL_ID = "__stats-tool__";
  const existing = document.getElementById(TOOL_ID);
  if (existing) { existing.remove(); return; }

  /* ── Utilities ─────────────────────────────────────────────── */
  function f(v, d = 4) { return isFinite(v) ? +v.toFixed(d) : "N/A"; }
  function escHtml(s) { return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;"); }

  const DATASET_COLORS = [
    { stroke: "#1a5abf", fill: "rgba(55,138,221,0.18)", box: "rgba(55,138,221,0.15)", badge: "#e8f0fe", text: "#1a5abf", border: "#b0c8f8", name: "Dataset A" },
    { stroke: "#b5393a", fill: "rgba(220,80,80,0.15)",  box: "rgba(220,80,80,0.13)",  badge: "#fde8e8", text: "#b5393a", border: "#f5bbbb", name: "Dataset B" },
    { stroke: "#1a7a40", fill: "rgba(46,180,96,0.15)",  box: "rgba(46,180,96,0.12)",  badge: "#edfaf3", text: "#1a7a40", border: "#c5e8d4", name: "Dataset C" },
    { stroke: "#8040bf", fill: "rgba(160,80,220,0.14)", box: "rgba(160,80,220,0.11)", badge: "#f5eeff", text: "#8040bf", border: "#d8b8f8", name: "Dataset D" },
  ];

  /* ── Stats engine ──────────────────────────────────────────── */
  function medianOf(arr) {
    const m = arr.length;
    if (m === 0) return 0;
    const mid = Math.floor(m / 2);
    return m % 2 === 0 ? (arr[mid - 1] + arr[mid]) / 2 : arr[mid];
  }
  function quartiles(sorted) {
    const n = sorted.length;
    const mid = Math.floor(n / 2);
    const lower = sorted.slice(0, mid);
    const upper = n % 2 === 0 ? sorted.slice(mid) : sorted.slice(mid + 1);
    return { q1: medianOf(lower), q2: medianOf(sorted), q3: medianOf(upper) };
  }
  function normalPDF(x) { return Math.exp(-0.5 * x * x) / Math.sqrt(2 * Math.PI); }
  function normalCDF(x) {
    const t = 1 / (1 + 0.2316419 * Math.abs(x));
    const poly = t * (0.319381530 + t * (-0.356563782 + t * (1.781477937 + t * (-1.821255978 + t * 1.330274429))));
    const p = 1 - normalPDF(x) * poly;
    return x >= 0 ? p : 1 - p;
  }
  function kde(nums, mean, stdDev) {
    const n = nums.length;
    const bw = 1.06 * stdDev * Math.pow(n, -0.2);
    return function(x) {
      let sum = 0;
      for (let i = 0; i < n; i++) {
        const z = (x - nums[i]) / bw;
        sum += Math.exp(-0.5 * z * z);
      }
      return sum / (n * bw * Math.sqrt(2 * Math.PI));
    };
  }
  function computeStats(nums) {
    const sorted = [...nums].sort((a, b) => a - b);
    const n = nums.length;
    const min = sorted[0], max = sorted[n - 1];
    const sum = nums.reduce((a, b) => a + b, 0);
    const mean = sum / n;
    const range = max - min;
    const { q1, q2, q3 } = quartiles(sorted);
    const iqr = q3 - q1;
    const lowerFence = q1 - 1.5 * iqr;
    const upperFence = q3 + 1.5 * iqr;
    const popVariance = nums.reduce((acc, v) => acc + (v - mean) ** 2, 0) / n;
    const popStdDev = Math.sqrt(popVariance);
    const sampleVariance = n > 1 ? nums.reduce((acc, v) => acc + (v - mean) ** 2, 0) / (n - 1) : 0;
    const sampleStdDev = Math.sqrt(sampleVariance);
    const skewness = n < 3 ? 0 :
      (nums.reduce((acc, v) => acc + ((v - mean) / (sampleStdDev || 1)) ** 3, 0) * n) / ((n - 1) * (n - 2));
    const freq = {};
    nums.forEach(v => { freq[v] = (freq[v] || 0) + 1; });
    const maxFreq = Math.max(...Object.values(freq));
    const modes = maxFreq === 1 ? ["No mode"] :
      Object.keys(freq).filter(k => freq[k] === maxFreq).map(Number).sort((a, b) => a - b);
    const zScores = nums.map(v => (v - mean) / (sampleStdDev || 1));
    const outliers = nums.filter(v => v < lowerFence || v > upperFence);
    let skewLabel = "Approximately symmetric";
    if (skewness > 0.5) skewLabel = "Right (positive) skew";
    else if (skewness < -0.5) skewLabel = "Left (negative) skew";
    else if (skewness > 0.1) skewLabel = "Slight right skew";
    else if (skewness < -0.1) skewLabel = "Slight left skew";
    return { nums, sorted, n, min, max, sum, mean, range, q1, q2, q3, iqr,
             lowerFence, upperFence, popVariance, popStdDev,
             sampleVariance, sampleStdDev, skewness, skewLabel, modes, zScores, outliers };
  }

  /* ── Dataset state ─────────────────────────────────────────── */
  let datasets = [{ id: 0, label: "Dataset A", raw: "", stats: null }];
  let nextId = 1;
  let activeTab = 0; // 0 = dataset tabs, -1 = comparison

  /* ── History ───────────────────────────────────────────────── */
  const MAX_HIST = 8;
  let history = [];
  function pushHistory(label, s) {
    history.unshift({ label, result: "n=" + s.n + "  μ=" + f(s.mean,3) + "  s=" + f(s.sampleStdDev,3), time: new Date().toLocaleTimeString() });
    if (history.length > MAX_HIST) history.pop();
    renderHistory();
  }
  function renderHistory() {
    const list = document.getElementById("__st-hist-list__");
    if (!list) return;
    if (!history.length) { list.innerHTML = '<span style="color:#bbb;font-size:12px;">No history yet</span>'; return; }
    list.innerHTML = history.map((h, i) =>
      '<div style="display:flex;gap:8px;align-items:baseline;padding:5px 8px;border-radius:6px;background:' + (i===0?"#f0f4ff":"transparent") + ';margin-bottom:3px;">' +
      '<span style="font-size:10px;color:#bbb;min-width:40px;font-family:monospace;">' + h.time + '</span>' +
      '<span style="font-size:11px;color:#444;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-family:monospace;">' + escHtml(h.label) + '</span>' +
      '<span style="font-size:10px;color:#1a5abf;background:#e8f0fe;border:1px solid #b0c8f8;border-radius:3px;padding:1px 5px;white-space:nowrap;font-family:monospace;">' + escHtml(h.result) + '</span>' +
      '</div>'
    ).join("");
  }

  /* ── Stem & Leaf ───────────────────────────────────────────── */
  function buildStemLeaf(nums) {
    if (!nums || nums.length === 0) return [];
    const sorted = [...nums].sort((a, b) => a - b);
    // Work with integers (multiply by 10 if needed for 1 decimal)
    const allInt = sorted.every(v => Number.isInteger(v));
    const scale = allInt ? 1 : 10;
    const scaled = sorted.map(v => Math.round(v * scale));
    const map = new Map();
    scaled.forEach(v => {
      const stem = Math.floor(v / 10);
      const leaf = ((v % 10) + 10) % 10;
      if (!map.has(stem)) map.set(stem, []);
      map.get(stem).push(leaf);
    });
    const stems = [...map.keys()].sort((a, b) => a - b);
    // Fill in missing stems
    if (stems.length > 1) {
      const minStem = stems[0], maxStem = stems[stems.length - 1];
      for (let s = minStem; s <= maxStem; s++) {
        if (!map.has(s)) map.set(s, []);
      }
    }
    const allStems = [...map.keys()].sort((a, b) => a - b);
    return allStems.map(stem => ({
      stem: stem,
      displayStem: allInt ? String(stem) : (stem / scale).toFixed(0),
      leaves: (map.get(stem) || []).sort((a, b) => a - b),
      scale
    }));
  }

  function renderStemLeaf(rows, color, label) {
    if (!rows.length) return '<div style="color:#bbb;font-size:12px;padding:8px;">Not enough data</div>';
    const maxLeaves = Math.max(...rows.map(r => r.leaves.length));
    const colW = 16;
    let html = `<div style="font-size:11px;color:${color.text};font-weight:600;margin-bottom:6px;font-family:monospace;">${escHtml(label)}</div>`;
    html += '<div style="overflow-x:auto;">';
    html += '<table style="border-collapse:collapse;font-family:monospace;font-size:13px;width:auto;">';
    html += `<thead><tr>
      <th style="padding:3px 10px 3px 4px;border-right:2px solid ${color.stroke};color:#888;font-size:10px;text-align:right;font-weight:500;">Stem</th>
      <th style="padding:3px 4px;color:#888;font-size:10px;text-align:left;font-weight:500;">Leaves</th>
    </tr></thead><tbody>`;
    rows.forEach(row => {
      const leaves = row.leaves.join("  ");
      html += `<tr>
        <td style="padding:3px 10px 3px 4px;border-right:2px solid ${color.stroke};text-align:right;color:${color.stroke};font-weight:600;">${escHtml(row.displayStem)}</td>
        <td style="padding:3px 8px;color:#333;letter-spacing:2px;">${escHtml(leaves) || '<span style="color:#ddd">·</span>'}</td>
      </tr>`;
    });
    html += '</tbody></table></div>';
    html += `<div style="margin-top:6px;font-size:10px;color:#aaa;">Key: stem | leaf represents stem×10 + leaf units${rows[0]?.scale > 1 ? ' (scaled ×' + rows[0].scale + ')' : ''}</div>`;
    return html;
  }

  function renderBackToBackStemLeaf(statsA, statsB, colA, colB) {
    // Build unified stem list
    const allNums = [...statsA.nums, ...statsB.nums];
    const rowsA = buildStemLeaf(statsA.nums);
    const rowsB = buildStemLeaf(statsB.nums);

    const stemSet = new Set([...rowsA.map(r => r.stem), ...rowsB.map(r => r.stem)]);
    const allStems = [...stemSet].sort((a, b) => a - b);

    // Fill gaps
    const minS = allStems[0], maxS = allStems[allStems.length - 1];
    for (let s = minS; s <= maxS; s++) stemSet.add(s);
    const stems = [...stemSet].sort((a, b) => a - b);

    const mapA = new Map(rowsA.map(r => [r.stem, r.leaves]));
    const mapB = new Map(rowsB.map(r => [r.stem, r.leaves]));

    let html = `<div style="font-size:11px;font-weight:600;margin-bottom:8px;">Back-to-Back Stem & Leaf</div>`;
    html += '<div style="overflow-x:auto;">';
    html += '<table style="border-collapse:collapse;font-family:monospace;font-size:12px;width:100%;">';
    html += `<thead><tr>
      <th style="padding:3px 8px;color:${colA.text};text-align:right;font-size:11px;min-width:120px;">${escHtml(colA.name)}</th>
      <th style="padding:3px 12px;text-align:center;color:#888;font-size:10px;border-left:2px solid #ccc;border-right:2px solid #ccc;min-width:40px;">Stem</th>
      <th style="padding:3px 8px;color:${colB.text};text-align:left;font-size:11px;min-width:120px;">${escHtml(colB.name)}</th>
    </tr></thead><tbody>`;

    stems.forEach(stem => {
      const leavesA = (mapA.get(stem) || []).sort((a, b) => a - b).reverse();
      const leavesB = (mapB.get(stem) || []).sort((a, b) => a - b);
      const strA = leavesA.join("  ");
      const strB = leavesB.join("  ");
      html += `<tr>
        <td style="padding:3px 8px;text-align:right;color:${colA.stroke};letter-spacing:2px;">${escHtml(strA) || '<span style="color:#eee">·</span>'}</td>
        <td style="padding:3px 12px;text-align:center;font-weight:600;color:#555;border-left:2px solid #ccc;border-right:2px solid #ccc;">${stem}</td>
        <td style="padding:3px 8px;text-align:left;color:${colB.stroke};letter-spacing:2px;">${escHtml(strB) || '<span style="color:#eee">·</span>'}</td>
      </tr>`;
    });

    html += '</tbody></table></div>';
    html += `<div style="margin-top:6px;font-size:10px;color:#aaa;text-align:center;">← ${escHtml(colA.name)} leaves read right-to-left &nbsp;|&nbsp; ${escHtml(colB.name)} leaves read left-to-right →</div>`;
    return html;
  }

  /* ── Canvas helpers ────────────────────────────────────────── */
  function makeCanvas(id, cssH) {
    const DPR = window.devicePixelRatio || 1;
    const canvas = document.getElementById(id);
    if (!canvas) return null;
    const cssW = canvas.parentElement.clientWidth - 2;
    canvas.style.width = cssW + "px";
    canvas.style.height = cssH + "px";
    canvas.width  = Math.round(cssW * DPR);
    canvas.height = Math.round(cssH * DPR);
    const ctx = canvas.getContext("2d");
    ctx.scale(DPR, DPR);
    return { ctx, W: cssW, H: cssH };
  }

  /* ── Box plot ─────────────────────────────────────────────── */
  function drawBoxPlot(ctx, W, H, statsArr, colors) {
    const n = statsArr.length;
    const PAD_L = 56, PAD_R = 24, PAD_T = 28, PAD_B = 36;
    const plotW = W - PAD_L - PAD_R;
    const trackH = (H - PAD_T - PAD_B) / n;

    // Global x range
    let globalMin = Infinity, globalMax = -Infinity;
    statsArr.forEach(s => {
      globalMin = Math.min(globalMin, s.min);
      globalMax = Math.max(globalMax, s.max);
    });
    const span = (globalMax - globalMin) || 1;
    const xMin = globalMin - span * 0.06;
    const xMax = globalMax + span * 0.06;
    const xSpan = xMax - xMin || 1;

    function xC(v) { return PAD_L + ((v - xMin) / xSpan) * plotW; }

    ctx.clearRect(0, 0, W, H);

    // Grid
    const nTicks = 6;
    ctx.font = "10px monospace"; ctx.textAlign = "center"; ctx.fillStyle = "#999";
    for (let i = 0; i <= nTicks; i++) {
      const v = xMin + (i / nTicks) * xSpan;
      const cx = xC(v);
      ctx.strokeStyle = "#eee"; ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(cx, PAD_T); ctx.lineTo(cx, H - PAD_B + 4); ctx.stroke();
      const lbl = Math.abs(v) >= 100 ? Math.round(v).toString() : v.toFixed(1);
      ctx.fillText(lbl, cx, H - PAD_B + 16);
    }

    statsArr.forEach((s, idx) => {
      const col = colors[idx];
      const midY = PAD_T + trackH * idx + trackH / 2;
      const boxH = Math.max(18, trackH * 0.44);
      const bTop = midY - boxH / 2, bBot = midY + boxH / 2;

      const wLo = s.sorted.find(v => v >= s.lowerFence) ?? s.min;
      const wHi = [...s.sorted].reverse().find(v => v <= s.upperFence) ?? s.max;
      const outlierPts = s.sorted.filter(v => v < s.lowerFence || v > s.upperFence);

      const bx1 = xC(s.q1), bx3 = xC(s.q3), bMed = xC(s.q2);

      // Label
      ctx.font = "bold 10px system-ui"; ctx.textAlign = "right"; ctx.fillStyle = col.stroke;
      ctx.fillText(col.name, PAD_L - 6, midY + 3.5);

      // IQR box
      ctx.fillStyle = col.box;
      ctx.fillRect(bx1, bTop, bx3 - bx1, boxH);
      ctx.strokeStyle = col.stroke; ctx.lineWidth = 1.8;
      ctx.strokeRect(bx1, bTop, bx3 - bx1, boxH);

      // Median
      ctx.strokeStyle = "#e24b4a"; ctx.lineWidth = 2.5;
      ctx.beginPath(); ctx.moveTo(bMed, bTop); ctx.lineTo(bMed, bBot); ctx.stroke();

      // Mean diamond
      const bMean = xC(s.mean); const dm = 4.5;
      ctx.fillStyle = "#f0992a"; ctx.strokeStyle = "#c07010"; ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(bMean, midY - dm); ctx.lineTo(bMean + dm, midY);
      ctx.lineTo(bMean, midY + dm); ctx.lineTo(bMean - dm, midY);
      ctx.closePath(); ctx.fill(); ctx.stroke();

      // Whiskers
      ctx.strokeStyle = "#555"; ctx.lineWidth = 1.6;
      ctx.beginPath(); ctx.moveTo(xC(wLo), midY); ctx.lineTo(bx1, midY); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(xC(wLo), bTop + boxH*0.2); ctx.lineTo(xC(wLo), bBot - boxH*0.2); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(bx3, midY); ctx.lineTo(xC(wHi), midY); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(xC(wHi), bTop + boxH*0.2); ctx.lineTo(xC(wHi), bBot - boxH*0.2); ctx.stroke();

      // Outliers
      outlierPts.forEach(v => {
        ctx.beginPath(); ctx.arc(xC(v), midY, 4, 0, 2 * Math.PI);
        ctx.fillStyle = "rgba(220,50,50,0.75)"; ctx.fill();
        ctx.strokeStyle = "#a32d2d"; ctx.lineWidth = 0.8; ctx.stroke();
      });
    });
  }

  /* ── KDE overlay ──────────────────────────────────────────── */
  function drawKDE(ctx, W, H, statsArr, colors) {
    const PAD_L = 52, PAD_R = 20, PAD_T = 40, PAD_B = 48;
    const plotW = W - PAD_L - PAD_R;
    const plotH = H - PAD_T - PAD_B;
    const baseline = PAD_T + plotH;

    // Global x range
    let globalMin = Infinity, globalMax = -Infinity;
    statsArr.forEach(s => {
      globalMin = Math.min(globalMin, s.min - s.sampleStdDev * 0.5);
      globalMax = Math.max(globalMax, s.max + s.sampleStdDev * 0.5);
    });
    const xSpan = (globalMax - globalMin) || 1;
    const STEPS = 500;

    // Peak across all datasets
    let yPeak = 0;
    statsArr.forEach(s => {
      const kdeFunc = kde(s.nums, s.mean, s.sampleStdDev);
      for (let i = 0; i <= STEPS; i++) {
        const y = kdeFunc(globalMin + (i / STEPS) * xSpan);
        if (y > yPeak) yPeak = y;
      }
    });
    yPeak *= 1.1;

    function xC(v) { return PAD_L + ((v - globalMin) / xSpan) * plotW; }
    function yC(y) { return baseline - (y / yPeak) * plotH; }

    ctx.clearRect(0, 0, W, H);

    // Baseline
    ctx.strokeStyle = "#ddd"; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(PAD_L, baseline); ctx.lineTo(PAD_L + plotW, baseline); ctx.stroke();

    // X-axis ticks
    const nTicks = 6;
    ctx.font = "10px monospace"; ctx.textAlign = "center"; ctx.fillStyle = "#999";
    for (let i = 0; i <= nTicks; i++) {
      const v = globalMin + (i / nTicks) * xSpan;
      const cx = xC(v);
      ctx.strokeStyle = "#eee"; ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(cx, PAD_T); ctx.lineTo(cx, baseline + 4); ctx.stroke();
      const lbl = Math.abs(v) >= 100 ? Math.round(v).toString() : v.toFixed(1);
      ctx.fillText(lbl, cx, baseline + 15);
    }

    // Draw each dataset KDE
    statsArr.forEach((s, idx) => {
      const col = colors[idx];
      const kdeFunc = kde(s.nums, s.mean, s.sampleStdDev);

      // Fill
      ctx.beginPath(); ctx.moveTo(xC(globalMin), baseline);
      for (let i = 0; i <= STEPS; i++) {
        const x = globalMin + (i / STEPS) * xSpan;
        ctx.lineTo(xC(x), yC(kdeFunc(x)));
      }
      ctx.lineTo(xC(globalMax), baseline); ctx.closePath();
      ctx.fillStyle = col.fill; ctx.fill();

      // Curve
      ctx.beginPath();
      for (let i = 0; i <= STEPS; i++) {
        const x = globalMin + (i / STEPS) * xSpan;
        i === 0 ? ctx.moveTo(xC(x), yC(kdeFunc(x))) : ctx.lineTo(xC(x), yC(kdeFunc(x)));
      }
      ctx.strokeStyle = col.stroke; ctx.lineWidth = 2.2; ctx.stroke();

      // Mean line
      ctx.strokeStyle = col.stroke; ctx.lineWidth = 1.5; ctx.setLineDash([5, 4]);
      ctx.beginPath(); ctx.moveTo(xC(s.mean), PAD_T + 4); ctx.lineTo(xC(s.mean), baseline); ctx.stroke();
      ctx.setLineDash([]);

      // Rug
      const rugY = baseline + 12 + idx * 8;
      s.nums.forEach(v => {
        const isOut = v < s.lowerFence || v > s.upperFence;
        ctx.beginPath(); ctx.arc(xC(Math.max(globalMin, Math.min(globalMax, v))), rugY, 2.5, 0, 2 * Math.PI);
        ctx.fillStyle = isOut ? "#e24b4a" : col.stroke; ctx.fill();
      });
    });

    // Legend
    const legX = PAD_L + 8, legY0 = PAD_T + 6;
    ctx.fillStyle = "rgba(255,255,255,0.92)";
    const legH = statsArr.length * 16 + 8;
    ctx.beginPath();
    if (ctx.roundRect) ctx.roundRect(legX - 4, legY0 - 4, 130, legH, 4);
    else ctx.rect(legX - 4, legY0 - 4, 130, legH);
    ctx.fill();
    statsArr.forEach((s, i) => {
      const col = colors[i];
      const ly = legY0 + i * 16 + 8;
      ctx.strokeStyle = col.stroke; ctx.lineWidth = 2.2; ctx.setLineDash([]);
      ctx.beginPath(); ctx.moveTo(legX + 2, ly); ctx.lineTo(legX + 18, ly); ctx.stroke();
      ctx.font = "10px system-ui"; ctx.fillStyle = "#444"; ctx.textAlign = "left";
      ctx.fillText(col.name + "  μ=" + f(s.mean, 2), legX + 24, ly + 3.5);
    });
  }

  /* ── Render comparison tab ────────────────────────────────── */
  function renderComparison() {
    const valid = datasets.filter(d => d.stats);
    if (valid.length < 2) {
      return '<div style="padding:24px;text-align:center;color:#aaa;font-size:13px;">Add and calculate at least 2 datasets to see comparisons.</div>';
    }

    const colors = valid.map((d, i) => ({ ...DATASET_COLORS[i % DATASET_COLORS.length], name: d.label }));

    let html = '';

    // Summary comparison table
    html += '<div class="__st-section__">Side-by-side summary</div>';
    html += '<div style="overflow-x:auto;"><table>';
    html += '<thead><tr><th>Statistic</th>';
    valid.forEach((d, i) => {
      html += `<th style="color:${colors[i].text};">${escHtml(d.label)}</th>`;
    });
    html += '</tr></thead><tbody>';

    const rows = [
      { key: "n", label: "Count (n)", fn: s => s.n },
      { key: "mean", label: "Mean (μ)", fn: s => f(s.mean, 4) },
      { key: "q2", label: "Median", fn: s => f(s.q2, 4) },
      { key: "sampleStdDev", label: "Std Dev (s)", fn: s => f(s.sampleStdDev, 4) },
      { key: "popStdDev", label: "Std Dev (σ)", fn: s => f(s.popStdDev, 4) },
      { key: "sampleVariance", label: "Variance (s²)", fn: s => f(s.sampleVariance, 4) },
      { key: "min", label: "Minimum", fn: s => f(s.min, 4) },
      { key: "max", label: "Maximum", fn: s => f(s.max, 4) },
      { key: "range", label: "Range", fn: s => f(s.range, 4) },
      { key: "q1", label: "Q1", fn: s => f(s.q1, 4) },
      { key: "q3", label: "Q3", fn: s => f(s.q3, 4) },
      { key: "iqr", label: "IQR", fn: s => f(s.iqr, 4) },
      { key: "skewness", label: "Skewness", fn: s => f(s.skewness, 4) },
      { key: "outliers", label: "Outliers", fn: s => s.outliers.length },
    ];

    // Numeric comparisons for highlight
    const numericKeys = ["mean","q2","sampleStdDev","min","max","range","iqr"];

    rows.forEach(row => {
      html += `<tr><td style="color:#555;font-weight:500;">${row.label}</td>`;
      const vals = valid.map(d => ({ raw: d.stats[row.key], display: row.fn(d.stats) }));
      vals.forEach((v, i) => {
        let extra = "";
        if (numericKeys.includes(row.key)) {
          const nums = vals.map(x => typeof x.raw === 'number' ? x.raw : parseFloat(x.raw)).filter(isFinite);
          if (nums.length > 1) {
            const n = typeof v.raw === 'number' ? v.raw : parseFloat(v.raw);
            const isMax = n === Math.max(...nums);
            const isMin = n === Math.min(...nums);
            if (isMax) extra = ' style="background:rgba(46,180,96,0.08);font-weight:600;"';
            else if (isMin) extra = ' style="background:rgba(220,80,80,0.07);font-weight:600;"';
          }
        }
        html += `<td${extra}>${escHtml(String(v.display))}</td>`;
      });
      html += '</tr>';
    });
    html += '</tbody></table></div>';
    html += '<div style="margin-top:6px;font-size:10px;color:#aaa;padding:4px 8px;background:#f9fafb;border-radius:5px;border:1px solid #eee;">Green = highest value · Red = lowest value (for numeric stats)</div>';

    // Difference analysis (2 datasets)
    if (valid.length === 2) {
      const sA = valid[0].stats, sB = valid[1].stats;
      const cA = colors[0], cB = colors[1];
      const meanDiff = sB.mean - sA.mean;
      const pooledSD = Math.sqrt((sA.sampleVariance + sB.sampleVariance) / 2);
      const cohensD = pooledSD > 0 ? Math.abs(meanDiff) / pooledSD : 0;
      let effectLabel = "negligible";
      if (cohensD >= 0.8) effectLabel = "large";
      else if (cohensD >= 0.5) effectLabel = "medium";
      else if (cohensD >= 0.2) effectLabel = "small";

      html += '<div class="__st-section__">Difference analysis</div>';
      html += '<div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;">';
      html += `<div class="__st-card__"><div class="__st-card-label__">Mean difference</div><div class="__st-card-value__" style="font-size:15px;">${f(meanDiff, 4)}</div><div style="font-size:10px;color:#888;margin-top:2px;">${meanDiff >= 0 ? cB.name : cA.name} is higher</div></div>`;
      html += `<div class="__st-card__"><div class="__st-card-label__">Cohen's d</div><div class="__st-card-value__" style="font-size:15px;">${f(cohensD, 4)}</div><div style="font-size:10px;color:#888;margin-top:2px;">Effect size: ${effectLabel}</div></div>`;
      html += `<div class="__st-card__"><div class="__st-card-label__">IQR difference</div><div class="__st-card-value__" style="font-size:15px;">${f(sB.iqr - sA.iqr, 4)}</div><div style="font-size:10px;color:#888;margin-top:2px;">Spread comparison</div></div>`;
      html += '</div>';

      // Back-to-back stem and leaf
      html += '<div class="__st-section__">Back-to-back stem & leaf</div>';
      html += '<div style="padding:10px 12px;background:#f5f7fb;border:1px solid #e4e8f0;border-radius:8px;">';
      html += renderBackToBackStemLeaf(sA, sB, cA, cB);
      html += '</div>';
    }

    // Combined box plot
    html += '<div class="__st-section__">Overlaid box plots</div>';
    const bpH = Math.max(80, valid.length * 60 + 60);
    html += `<canvas id="__st-cmp-box__" style="width:100%;border-radius:8px;background:#f9fbff;border:1px solid #e4e8f0;display:block;"></canvas>`;

    // Combined KDE
    html += '<div class="__st-section__">Overlaid density curves (KDE)</div>';
    html += `<canvas id="__st-cmp-kde__" style="width:100%;border-radius:8px;background:#f9fbff;border:1px solid #e4e8f0;display:block;"></canvas>`;

    return html;
  }

  /* ── Render single dataset ────────────────────────────────── */
  function renderSingle(s, colIdx) {
    const col = DATASET_COLORS[colIdx % DATASET_COLORS.length];
    let html = "";

    const mainStats=[
      {label:"Count (n)",val:s.n},
      {label:"Minimum",val:f(s.min,4)},
      {label:"Maximum",val:f(s.max,4)},
      {label:"Range",val:f(s.range,4)},
      {label:"Sum",val:f(s.sum,4)},
      {label:"Mean (μ)",val:f(s.mean,4)},
      {label:"Median (Q2)",val:f(s.q2,4)},
      {label:"Mode",val:s.modes.join(", "),sm:true},
      {label:"Skewness",val:f(s.skewness,4)},
    ];
    html+='<div class="__st-section__">Descriptive statistics</div>';
    html+='<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(118px,1fr));gap:7px;">';
    mainStats.forEach(({label,val,sm})=>{
      html+=`<div class="__st-card__"><div class="__st-card-label__">${label}</div><div class="__st-card-value__ ${sm?"sm":""}">${escHtml(String(val))}</div></div>`;
    });
    html+="</div>";
    html+=`<div style="margin-top:8px;padding:7px 12px;background:${col.badge};border-radius:7px;font-size:12px;color:${col.text};border:1px solid ${col.border};">${escHtml(s.skewLabel)}</div>`;

    html+='<div class="__st-section__">Standard deviation &amp; variance</div>';
    html+='<div style="display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-bottom:4px;">';
    html+=`<div class="__st-card__" style="background:#eef4ff;border-color:#c7d9f8;">
      <div class="__st-card-label__" style="color:#1a5abf;">Population Std Dev (σ)</div>
      <div class="__st-card-value__" style="font-size:15px;">${f(s.popStdDev,6)}</div>
      <div style="font-size:10px;color:#7a9ad4;margin-top:3px;">Divide by n = ${s.n}</div>
    </div>`;
    html+=`<div class="__st-card__" style="background:#edfaf3;border-color:#c5e8d4;">
      <div class="__st-card-label__" style="color:#1a7a40;">Sample Std Dev (s)</div>
      <div class="__st-card-value__" style="font-size:15px;">${f(s.sampleStdDev,6)}</div>
      <div style="font-size:10px;color:#5aaa7a;margin-top:3px;">Divide by n−1 = ${s.n-1}</div>
    </div>`;
    html+=`<div class="__st-card__" style="background:#eef4ff;border-color:#c7d9f8;">
      <div class="__st-card-label__" style="color:#1a5abf;">Population Variance (σ²)</div>
      <div class="__st-card-value__" style="font-size:14px;">${f(s.popVariance,6)}</div>
    </div>`;
    html+=`<div class="__st-card__" style="background:#edfaf3;border-color:#c5e8d4;">
      <div class="__st-card-label__" style="color:#1a7a40;">Sample Variance (s²)</div>
      <div class="__st-card-value__" style="font-size:14px;">${f(s.sampleVariance,6)}</div>
    </div>`;
    html+="</div>";
    html+=`<div style="padding:7px 12px;background:#fafafa;border-radius:7px;font-size:11px;color:#888;border:1px solid #eee;line-height:1.6;">
      <strong style="color:#555;">Which to use?</strong> Use <span style="color:#1a5abf;font-weight:600;">σ (population)</span> when your data <em>is</em> the entire group.
      Use <span style="color:#1a7a40;font-weight:600;">s (sample)</span> when your data is a <em>subset</em> drawn from a larger population.
    </div>`;

    const spreadStats=[
      {label:"Q1 (25th pct)",val:f(s.q1,4)},
      {label:"Q2 Median (50th)",val:f(s.q2,4)},
      {label:"Q3 (75th pct)",val:f(s.q3,4)},
      {label:"IQR (Q3−Q1)",val:f(s.iqr,4)},
      {label:"Lower fence",val:f(s.lowerFence,4)},
      {label:"Upper fence",val:f(s.upperFence,4)},
    ];
    html+='<div class="__st-section__">Five-number summary &amp; fences</div>';
    html+=`<div style="padding:6px 10px;background:#fffde8;border:1px solid #f0e0a0;border-radius:6px;font-size:11px;color:#7a6000;margin-bottom:8px;">
      Quartiles use the <strong>exclusive / textbook method</strong>: the median is excluded when splitting into halves.
    </div>`;
    html+='<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(118px,1fr));gap:7px;">';
    spreadStats.forEach(({label,val})=>{
      html+=`<div class="__st-card__"><div class="__st-card-label__">${label}</div><div class="__st-card-value__">${escHtml(String(val))}</div></div>`;
    });
    html+="</div>";
    if(s.outliers.length>0){
      html+=`<div style="margin-top:8px;padding:7px 12px;background:#fff8f8;border-radius:7px;font-size:12px;color:#c00;border:1px solid #f5bbbb;">Outliers (fence method): <strong>${s.outliers.map(v=>f(v,4)).join(", ")}</strong> — outside [${f(s.lowerFence,3)}, ${f(s.upperFence,3)}]</div>`;
    } else {
      html+=`<div style="margin-top:8px;padding:7px 12px;background:#f0faf5;border-radius:7px;font-size:12px;color:#1a7a40;border:1px solid #b0ddc0;">No fence outliers detected — all values within [${f(s.lowerFence,3)}, ${f(s.upperFence,3)}]</div>`;
    }

    html+='<div class="__st-section__">Box plot</div>';
    html+='<canvas id="__st-boxplot__" style="width:100%;border-radius:8px;background:#f9fbff;border:1px solid #e4e8f0;display:block;"></canvas>';

    html+='<div class="__st-section__">Density curve (KDE)</div>';
    html+='<canvas id="__st-canvas__" style="width:100%;border-radius:8px;background:#f9fbff;border:1px solid #e4e8f0;display:block;"></canvas>';

    // Stem & Leaf
    html+='<div class="__st-section__">Stem &amp; leaf plot</div>';
    html+='<div style="padding:10px 12px;background:#f5f7fb;border:1px solid #e4e8f0;border-radius:8px;">';
    const stemRows = buildStemLeaf(s.nums);
    html += renderStemLeaf(stemRows, col, "");
    html+='</div>';

    html+='<div class="__st-section__">Z-scores &amp; outlier analysis</div>';
    html+='<div style="overflow-x:auto;"><table>';
    html+='<thead><tr><th>#</th><th>Value</th><th>Z-score</th><th>Percentile</th><th>Fence out</th><th>|Z|>2</th><th>|Z|>3</th></tr></thead><tbody>';
    s.nums.forEach((v,i)=>{
      const z=s.zScores[i];
      const isFenceOut=v<s.lowerFence||v>s.upperFence;
      const isZ2=Math.abs(z)>2,isZ3=Math.abs(z)>3;
      const pct=(normalCDF(z)*100).toFixed(1)+"%";
      const rowClass=isFenceOut?'class="outlier-row"':"";
      html+=`<tr ${rowClass}><td>${i+1}</td><td>${f(v,4)}</td><td>${f(z,4)}</td><td>${pct}</td>
        <td>${isFenceOut?'<span class="__st-out-badge__">YES</span>':"no"}</td>
        <td>${isZ2?'<span class="__st-z-badge__">YES</span>':"no"}</td>
        <td>${isZ3?'<span class="__st-out-badge__">YES</span>':"no"}</td></tr>`;
    });
    html+="</tbody></table></div>";

    return html;
  }

  /* ── Old box/kde draw (single) ────────────────────────────── */
  function drawSingleBoxPlot(ctx, W, H, s, col) {
    drawBoxPlot(ctx, W, H, [s], [col]);
  }

  function drawSingleKDE(ctx, W, H, s, col) {
    drawKDE(ctx, W, H, [s], [col]);
  }

  /* ── Main render ──────────────────────────────────────────── */
  function renderActiveTab() {
    const body = document.getElementById("__st-body__");
    if (!body) return;

    if (activeTab === -1) {
      // Comparison tab
      body.innerHTML = renderComparison();
      // Draw canvases
      const valid = datasets.filter(d => d.stats);
      const colors = valid.map((d, i) => ({ ...DATASET_COLORS[i % DATASET_COLORS.length], name: d.label }));
      if (valid.length >= 2) {
        const bpH = Math.max(90, valid.length * 55 + 65);
        requestAnimationFrame(() => {
          const bp = makeCanvas("__st-cmp-box__", bpH);
          if (bp) drawBoxPlot(bp.ctx, bp.W, bp.H, valid.map(d => d.stats), colors);
          const kd = makeCanvas("__st-cmp-kde__", 260);
          if (kd) drawKDE(kd.ctx, kd.W, kd.H, valid.map(d => d.stats), colors);
        });
      }
      return;
    }

    const ds = datasets[activeTab];
    if (!ds) return;
    if (!ds.stats) {
      body.innerHTML = '<div style="padding:24px 0;text-align:center;color:#ccc;font-size:13px;">Enter numbers above and click Calculate.</div>';
      return;
    }
    const colIdx = datasets.indexOf(ds);
    const col = { ...DATASET_COLORS[colIdx % DATASET_COLORS.length], name: ds.label };

    body.innerHTML = renderSingle(ds.stats, colIdx);

    requestAnimationFrame(() => {
      const bp = makeCanvas("__st-boxplot__", 130);
      if (bp) drawSingleBoxPlot(bp.ctx, bp.W, bp.H, ds.stats, col);
      const kd = makeCanvas("__st-canvas__", 260);
      if (kd) drawSingleKDE(kd.ctx, kd.W, kd.H, ds.stats, col);
    });
  }

  /* ── Build UI ─────────────────────────────────────────────── */
  function buildInputArea() {
    return `
    <div id="__st-inputs__">
      <div id="__st-dataset-tabs__" style="display:flex;gap:4px;margin-bottom:8px;flex-wrap:wrap;align-items:center;"></div>
      <div id="__st-dataset-input-wrap__"></div>
      <div style="display:flex;gap:8px;margin-top:8px;align-items:center;flex-wrap:wrap;">
        <button id="__st-go__" style="flex:1;min-width:120px;margin-bottom:0;">Calculate</button>
        <button id="__st-clear__" style="padding:10px 16px;border:1px solid #ddd;border-radius:8px;background:#fff;color:#555;font-size:13px;cursor:pointer;white-space:nowrap;">Clear</button>
        <button id="__st-add-ds__" style="padding:10px 14px;border:1px solid #1a5abf;border-radius:8px;background:#f0f4ff;color:#1a5abf;font-size:13px;cursor:pointer;white-space:nowrap;font-weight:500;">+ Add Dataset</button>
      </div>
      <div id="__st-err__" style="min-height:16px;margin-top:6px;font-size:12px;color:#c00;"></div>
      <div style="margin-top:10px;display:flex;gap:5px;flex-wrap:wrap;" id="__st-examples__">
        <span style="font-size:10px;color:#bbb;align-self:center;">Examples:</span>
      </div>
    </div>`;
  }

  function renderDatasetTabs() {
    const tabsEl = document.getElementById("__st-dataset-tabs__");
    if (!tabsEl) return;
    let html = '';
    datasets.forEach((ds, i) => {
      const col = DATASET_COLORS[i % DATASET_COLORS.length];
      const isActive = activeTab === i;
      html += `<div onclick="window.__stSelectTab__(${i})" style="display:flex;align-items:center;gap:4px;padding:5px 10px;border-radius:6px;cursor:pointer;font-size:12px;font-weight:500;border:1.5px solid ${isActive ? col.stroke : '#ddd'};background:${isActive ? col.badge : '#f7f7f7'};color:${isActive ? col.text : '#666'};transition:all .12s;">
        <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:${col.stroke};"></span>
        <span id="__st-tab-label-${ds.id}__" contenteditable="${isActive ? 'true' : 'false'}" onblur="window.__stRenameDs__(${ds.id},this.textContent)" style="outline:none;cursor:${isActive?'text':'pointer'};min-width:40px;">${escHtml(ds.label)}</span>
        ${datasets.length > 1 ? `<span onclick="event.stopPropagation();window.__stRemoveDs__(${ds.id})" style="margin-left:2px;color:#bbb;font-size:13px;line-height:1;cursor:pointer;" title="Remove">✕</span>` : ''}
      </div>`;
    });
    // Comparison tab
    const hasMulti = datasets.filter(d => d.stats).length >= 2;
    const isCmpActive = activeTab === -1;
    html += `<div onclick="window.__stSelectTab__(-1)" style="padding:5px 10px;border-radius:6px;cursor:pointer;font-size:12px;font-weight:500;border:1.5px solid ${isCmpActive?'#7a5abf':'#ddd'};background:${isCmpActive?'#f5eeff':'#f7f7f7'};color:${isCmpActive?'#7a5abf':hasMulti?'#666':'#ccc'};transition:all .12s;${!hasMulti?'opacity:0.5;':''}">${hasMulti ? '⊕ Compare' : '⊕ Compare (need 2+)'}</div>`;
    tabsEl.innerHTML = html;
  }

  function renderDatasetInputArea() {
    const wrap = document.getElementById("__st-dataset-input-wrap__");
    if (!wrap) return;
    if (activeTab === -1) {
      wrap.innerHTML = '<div style="padding:8px 10px;background:#f5f0ff;border:1px solid #ddd;border-radius:8px;font-size:12px;color:#7a5abf;">Select a dataset tab above to edit data.</div>';
      return;
    }
    const ds = datasets[activeTab];
    if (!ds) return;
    const col = DATASET_COLORS[datasets.indexOf(ds) % DATASET_COLORS.length];
    wrap.innerHTML = `<div style="position:relative;">
      <div style="position:absolute;left:10px;top:9px;font-size:10px;font-weight:600;color:${col.stroke};letter-spacing:.04em;text-transform:uppercase;z-index:1;">${escHtml(ds.label)}</div>
      <textarea id="__st-input__" rows="2" style="width:100%;padding:9px 12px;padding-top:24px;border:1.5px solid ${col.stroke};border-radius:8px;font-size:13px;font-family:monospace;outline:none;color:#111;background:#fff;resize:none;box-sizing:border-box;" placeholder="Enter numbers separated by commas, e.g.  3, 7, 12, 5, 9">${escHtml(ds.raw)}</textarea>
    </div>`;
    const ta = document.getElementById("__st-input__");
    if (ta) {
      ta.addEventListener("keydown", e => { if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); run(); } });
      ta.addEventListener("input", () => { if (datasets[activeTab]) datasets[activeTab].raw = ta.value; });
    }
  }

  /* ── Run ───────────────────────────────────────────────────── */
  function run() {
    if (activeTab === -1) return;
    const ds = datasets[activeTab];
    if (!ds) return;
    const raw = (document.getElementById("__st-input__") || {}).value || ds.raw;
    ds.raw = raw;
    const errEl = document.getElementById("__st-err__");
    if (errEl) errEl.textContent = "";
    const nums = raw.split(/[\s,]+/).map(s=>s.trim()).filter(s=>s!=="").map(Number);
    if (nums.length < 2) { if (errEl) errEl.textContent = "Please enter at least 2 numbers."; return; }
    if (nums.some(isNaN)) { if (errEl) errEl.textContent = "One or more values are not valid numbers."; return; }
    ds.stats = computeStats(nums);
    pushHistory(ds.label + ": " + raw.trim().slice(0, 50), ds.stats);
    renderDatasetTabs();
    renderActiveTab();
  }

  /* ── Global actions ────────────────────────────────────────── */
  window.__stSelectTab__ = function(idx) {
    activeTab = idx;
    renderDatasetTabs();
    renderDatasetInputArea();
    renderActiveTab();
  };
  window.__stRenameDs__ = function(id, newLabel) {
    const ds = datasets.find(d => d.id === id);
    if (ds && newLabel.trim()) {
      ds.label = newLabel.trim().slice(0, 20);
      renderDatasetTabs();
    }
  };
  window.__stRemoveDs__ = function(id) {
    const idx = datasets.findIndex(d => d.id === id);
    if (idx === -1 || datasets.length <= 1) return;
    datasets.splice(idx, 1);
    activeTab = Math.min(activeTab, datasets.length - 1);
    if (activeTab < 0) activeTab = 0;
    renderDatasetTabs();
    renderDatasetInputArea();
    renderActiveTab();
  };

  /* ── DOM build ─────────────────────────────────────────────── */
  const overlay = document.createElement("div");
  overlay.id = TOOL_ID;
  overlay.style.cssText = "position:fixed;top:20px;right:20px;z-index:999999;width:580px;max-width:calc(100vw - 40px);background:#fff;color:#111;border:1px solid #ddd;border-radius:14px;box-shadow:0 8px 40px rgba(0,0,0,0.18);font-family:system-ui,sans-serif;font-size:14px;overflow:hidden;max-height:calc(100vh - 40px);display:flex;flex-direction:column;";

  const styleEl = document.createElement("style");
  styleEl.textContent = [
    "#__stats-tool__ *{box-sizing:border-box;}",
    "#__st-input__{width:100%;padding:9px 12px;border:1.5px solid #bbb;border-radius:8px;font-size:14px;font-family:monospace;outline:none;color:#111;background:#fff;transition:border-color 0.15s;resize:none;}",
    "#__st-input__:focus{border-color:#1a5abf;}",
    "#__st-go__{width:100%;padding:10px;background:#1a1a1a;color:#fff;border:none;border-radius:8px;font-size:14px;font-weight:500;cursor:pointer;letter-spacing:0.02em;transition:background 0.15s;}",
    "#__st-go__:hover{background:#333;}",
    "#__st-add-ds__:hover{background:#dce9ff!important;}",
    ".__st-card__{background:#f5f7fb;border:1px solid #e4e8f0;border-radius:8px;padding:8px 12px;min-width:0;}",
    ".__st-card-label__{font-size:10px;color:#888;text-transform:uppercase;letter-spacing:.06em;margin-bottom:3px;}",
    ".__st-card-value__{font-size:17px;font-weight:600;color:#111;font-family:Georgia,serif;word-break:break-all;}",
    ".__st-card-value__.sm{font-size:13px;}",
    ".__st-section__{font-size:10px;color:#bbb;text-transform:uppercase;letter-spacing:.07em;margin:14px 0 7px;}",
    ".__st-out-badge__{font-size:10px;font-family:monospace;background:#fff0f0;color:#c00;border:1px solid #f5bbbb;border-radius:3px;padding:1px 5px;margin-left:5px;}",
    ".__st-z-badge__{font-size:10px;font-family:monospace;background:#fff7e0;color:#805500;border:1px solid #f5dfa0;border-radius:3px;padding:1px 5px;margin-left:5px;}",
    ".__st-scroll__{overflow-y:auto;flex:1;padding:0 16px 16px;}",
    "table{width:100%;border-collapse:collapse;font-size:12px;}",
    "th{text-align:left;padding:5px 8px;border-bottom:1px solid #eee;color:#888;font-weight:500;font-size:11px;white-space:nowrap;}",
    "td{padding:5px 8px;border-bottom:1px solid #f3f3f3;color:#333;white-space:nowrap;font-family:monospace;}",
    "tr:last-child td{border-bottom:none;}",
    "tr.outlier-row td{background:#fff8f8;color:#c00;}",
  ].join("");
  overlay.appendChild(styleEl);

  overlay.innerHTML += `
  <div id="__st-hdr__" style="display:flex;align-items:center;justify-content:space-between;padding:12px 16px;background:#f7f7f7;border-bottom:1px solid #e8e8e8;cursor:move;user-select:none;flex-shrink:0;">
    <div style="display:flex;align-items:center;gap:10px;">
      <span style="font-weight:700;font-size:15px;letter-spacing:-0.3px;">Statistics Tool</span>
      <span style="font-size:11px;color:#aaa;font-style:italic;">v5 · multi-dataset</span>
    </div>
    <button id="__st-x__" style="background:none;border:none;font-size:18px;cursor:pointer;padding:0 4px;color:#666;line-height:1;">✕</button>
  </div>
  <div style="padding:14px 16px 12px;border-bottom:1px solid #eee;flex-shrink:0;">${buildInputArea()}</div>
  <div class="__st-scroll__" id="__st-body__">
    <div style="padding:24px 0;text-align:center;color:#ccc;font-size:13px;">Enter numbers above to see statistics</div>
  </div>
  <div style="border-top:1px solid #eee;padding:10px 16px 12px;flex-shrink:0;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
      <span style="font-size:10px;color:#bbb;text-transform:uppercase;letter-spacing:.07em;">History</span>
      <button onclick="window.__st_clearHistory&&window.__st_clearHistory()" style="font-size:11px;color:#bbb;background:none;border:none;cursor:pointer;padding:0;">Clear</button>
    </div>
    <div id="__st-hist-list__" style="max-height:80px;overflow-y:auto;"><span style="color:#bbb;font-size:12px;">No history yet</span></div>
  </div>`;

  document.body.appendChild(overlay);

  // Examples
  const examples = [
    { label: "Symmetric", val: "2, 4, 6, 4, 2, 6, 4, 5, 3, 4" },
    { label: "Right skew", val: "1, 2, 2, 3, 3, 3, 10, 15, 20, 25" },
    { label: "With outliers", val: "5, 6, 7, 8, 6, 7, 6, 5, 100, 4" },
    { label: "Class test", val: "45, 67, 72, 55, 88, 91, 60, 73, 66, 79, 82, 50" },
  ];
  const exDiv = document.getElementById("__st-examples__");
  if (exDiv) examples.forEach(ex => {
    const chip = document.createElement("button");
    chip.textContent = ex.label;
    chip.style.cssText = "padding:3px 10px;font-size:11px;border:1px solid #ddd;border-radius:999px;cursor:pointer;color:#555;background:#f5f5f5;";
    chip.onmouseover = () => chip.style.background = "#e8e8e8";
    chip.onmouseout = () => chip.style.background = "#f5f5f5";
    chip.onclick = () => {
      if (activeTab >= 0 && datasets[activeTab]) {
        datasets[activeTab].raw = ex.val;
        renderDatasetInputArea();
      }
    };
    exDiv.appendChild(chip);
  });

  // Buttons
  document.getElementById("__st-go__").onclick = run;
  document.getElementById("__st-clear__").onclick = () => {
    if (activeTab >= 0 && datasets[activeTab]) {
      datasets[activeTab].raw = "";
      datasets[activeTab].stats = null;
      renderDatasetInputArea();
      renderDatasetTabs();
    }
    const errEl = document.getElementById("__st-err__");
    if (errEl) errEl.textContent = "";
    document.getElementById("__st-body__").innerHTML = '<div style="padding:24px 0;text-align:center;color:#ccc;font-size:13px;">Enter numbers above to see statistics</div>';
  };
  document.getElementById("__st-add-ds__").onclick = () => {
    if (datasets.length >= 4) { alert("Maximum 4 datasets supported."); return; }
    const col = DATASET_COLORS[datasets.length];
    const ds = { id: nextId++, label: col.name, raw: "", stats: null };
    datasets.push(ds);
    activeTab = datasets.length - 1;
    renderDatasetTabs();
    renderDatasetInputArea();
    renderActiveTab();
  };

  // Drag
  let dragging=false,dx=0,dy=0;
  document.getElementById("__st-hdr__").addEventListener("mousedown",e=>{
    dragging=true;
    const r=overlay.getBoundingClientRect();
    dx=e.clientX-r.left;dy=e.clientY-r.top;
    overlay.style.transition="none";
  });
  document.addEventListener("mousemove",e=>{
    if(!dragging)return;
    overlay.style.left=(e.clientX-dx)+"px";
    overlay.style.top=(e.clientY-dy)+"px";
    overlay.style.right="auto";
  });
  document.addEventListener("mouseup",()=>{dragging=false;});
  document.getElementById("__st-x__").onclick=()=>overlay.remove();
  window.__st_clearHistory=()=>{history=[];renderHistory();};

  // Initial render
  renderDatasetTabs();
  renderDatasetInputArea();
})();
