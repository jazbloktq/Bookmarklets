      html += `<div class="__st-card__"><div class="__st-card-label__">Cohen's d</div><div class="__st-card-value__" style="font-size:15px;">${f(cohensD,4)}</div><div style="font-size:10px;color:#888;margin-top:2px;">Effect size: ${effectLabel}</div></div>`;
      html += `<div class="__st-card__"><div class="__st-card-label__">IQR difference</div><div class="__st-card-value__" style="font-size:15px;">${f(sB.iqr-sA.iqr,4)}</div><div style="font-size:10px;color:#888;margin-top:2px;">Spread comparison</div></div>`;
      html += '</div>';
      html += '<div class="__st-section__">Back-to-back stem & leaf</div>';
      html += '<div style="padding:10px 12px;background:#f5f7fb;border:1px solid #e4e8f0;border-radius:8px;">';
      html += renderBackToBackStemLeaf(sA, sB, cA, cB);
      html += '</div>';
    }

    const bpH = Math.max(80, valid.length * 60 + 60);
    html += '<div class="__st-section__">Overlaid box plots</div>';
    html += `<canvas id="__st-cmp-box__" style="width:100%;border-radius:8px;background:#f9fbff;border:1px solid #e4e8f0;display:block;"></canvas>`;
    html += '<div class="__st-section__">Overlaid density curves (KDE)</div>';
    html += `<canvas id="__st-cmp-kde__" style="width:100%;border-radius:8px;background:#f9fbff;border:1px solid #e4e8f0;display:block;"></canvas>`;
    return html;
  }

