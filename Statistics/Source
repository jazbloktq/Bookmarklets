    });
    html+="</tbody></table></div>";
    return html;
  }

  /* ── Render box plot input mode results ────────────────────── */
  function renderBPSummary(bpState, colIdx) {
    const col = DATASET_COLORS[colIdx % DATASET_COLORS.length];
    const { min, q1, med, q3, max, n, outlierList } = bpState;
    const iqr = q3 - q1;
    const range = max - min;
    const lowerFence = q1 - 1.5 * iqr;
    const upperFence = q3 + 1.5 * iqr;
    // Approximate mean from Bowley's formula — not exact, but a reasonable estimate
    // For symmetric distribution mean ≈ median, skewed we can note it
    const bowleySkew = (q3 + q1 - 2*med) / iqr;
    let skewLabel = "Approximately symmetric";
    if (bowleySkew > 0.2) skewLabel = "Right (positive) skew";
    else if (bowleySkew < -0.2) skewLabel = "Left (negative) skew";

    // Estimate std dev: for roughly normal data, IQR ≈ 1.35σ
    const estSD = iqr / 1.35;
    const estMean = (min + 2*q1 + 2*med + 2*q3 + max) / 8; // weighted centroid estimate

    let html = '';
    html += '<div style="padding:6px 12px;background:#fff7e0;border:1px solid #f5dfa0;border-radius:7px;font-size:11px;color:#7a5500;margin-bottom:10px;">';
    html += '⚠ These results are derived from summary statistics only. Mean, std dev, and variance are <strong>estimates</strong> — exact values require raw data.';
    html += '</div>';

    const cards = [
      { label: "Minimum", val: f(min, 4) },
      { label: "Q1 (25th)", val: f(q1, 4) },
      { label: "Median (Q2)", val: f(med, 4) },
      { label: "Q3 (75th)", val: f(q3, 4) },
      { label: "Maximum", val: f(max, 4) },
      { label: "IQR (Q3−Q1)", val: f(iqr, 4) },
      { label: "Range", val: f(range, 4) },
      { label: "Lower fence", val: f(lowerFence, 4) },
      { label: "Upper fence", val: f(upperFence, 4) },
      { label: "Est. Std Dev (σ≈IQR/1.35)", val: f(estSD, 4), note: true },
      { label: "Bowley skewness", val: f(bowleySkew, 4) },
    ];
    if (n) cards.unshift({ label: "Count (n)", val: n });

    html += '<div class="__st-section__">Summary statistics</div>';
    html += '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:7px;">';
    cards.forEach(({ label, val, note }) => {
      html += `<div class="__st-card__" ${note?'style="border-color:#f5dfa0;background:#fffde8;"':''}>
        <div class="__st-card-label__">${escHtml(label)}</div>
        <div class="__st-card-value__" style="font-size:15px;">${escHtml(String(val))}</div>
      </div>`;
    });
    html += '</div>';
    html += `<div style="margin-top:8px;padding:7px 12px;background:${col.badge};border-radius:7px;font-size:12px;color:${col.text};border:1px solid ${col.border};">${skewLabel} (Bowley's coefficient: ${f(bowleySkew,4)})</div>`;

    if (outlierList.length > 0) {
      html += `<div style="margin-top:8px;padding:7px 12px;background:#fff8f8;border-radius:7px;font-size:12px;color:#c00;border:1px solid #f5bbbb;">
        Outliers provided: <strong>${outlierList.map(v=>f(v,4)).join(", ")}</strong>
        ${outlierList.some(v => v < lowerFence || v > upperFence) ? ' ✓ (outside fence)' : ' — within fence range'}
      </div>`;
    } else {
      html += `<div style="margin-top:8px;padding:7px 12px;background:#f0faf5;border-radius:7px;font-size:12px;color:#1a7a40;border:1px solid #b0ddc0;">No outliers provided. Fence bounds: [${f(lowerFence,3)}, ${f(upperFence,3)}]</div>`;
    }

    html += '<div class="__st-section__">Box plot</div>';
    html += `<canvas id="__st-bp-canvas__" style="width:100%;border-radius:8px;background:#f9fbff;border:1px solid #e4e8f0;display:block;"></canvas>`;

    html += '<div class="__st-section__">What you can derive from a box plot</div>';
    html += `<div style="overflow-x:auto;"><table>
      <thead><tr><th>Statistic</th><th>Can derive?</th><th>Value / Note</th></tr></thead>
      <tbody>
      <tr><td>Median</td><td style="color:#1a7a40;">✓ Exact</td><td>${f(med,4)}</td></tr>
      <tr><td>Q1 / Q3</td><td style="color:#1a7a40;">✓ Exact</td><td>${f(q1,4)} / ${f(q3,4)}</td></tr>
      <tr><td>IQR</td><td style="color:#1a7a40;">✓ Exact</td><td>${f(iqr,4)}</td></tr>
      <tr><td>Range</td><td style="color:#1a7a40;">✓ Exact</td><td>${f(range,4)}</td></tr>
      <tr><td>Fences</td><td style="color:#1a7a40;">✓ Exact</td><td>[${f(lowerFence,3)}, ${f(upperFence,3)}]</td></tr>
      <tr><td>Skewness (Bowley)</td><td style="color:#1a7a40;">✓ Exact</td><td>${f(bowleySkew,4)}</td></tr>
      <tr><td>Mean</td><td style="color:#c07010;">~ Estimate only</td><td>Cannot determine exactly without raw data</td></tr>
      <tr><td>Std deviation</td><td style="color:#c07010;">~ Estimate only</td><td>≈ IQR / 1.35 = ${f(estSD,4)} (assumes normality)</td></tr>
      <tr><td>Mode</td><td style="color:#c00;">✗ Cannot determine</td><td>Requires raw data</td></tr>
      <tr><td>Individual values</td><td style="color:#c00;">✗ Cannot determine</td><td>Only min/max are known</td></tr>
      </tbody>
    </table></div>`;

    return html;
  }

