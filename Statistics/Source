    }
    const colors = valid.map((d, i) => ({ ...DATASET_COLORS[i % DATASET_COLORS.length], name: d.label }));
    let html = '';
    html += '<div class="__st-section__">Side-by-side summary</div>';
    html += '<div style="overflow-x:auto;"><table>';
    html += '<thead><tr><th>Statistic</th>';
    valid.forEach((d, i) => { html += `<th style="color:${colors[i].text};">${escHtml(d.label)}</th>`; });
    html += '</tr></thead><tbody>';
    const rows = [
      { key: "n", label: "Count (n)", fn: s => s.n },
