      { key: "min", label: "Minimum", fn: s => f(s.min, 4) },
      { key: "max", label: "Maximum", fn: s => f(s.max, 4) },
      { key: "range", label: "Range", fn: s => f(s.range, 4) },
      { key: "q1", label: "Q1", fn: s => f(s.q1, 4) },
      { key: "q3", label: "Q3", fn: s => f(s.q3, 4) },
      { key: "iqr", label: "IQR", fn: s => f(s.iqr, 4) },
      { key: "skewness", label: "Skewness", fn: s => f(s.skewness, 4) },
      { key: "outliers", label: "Outliers", fn: s => s.outliers.length },
    ];
    const numericKeys = ["mean","q2","sampleStdDev","min","max","range","iqr"];
    rows.forEach(row => {
      html += `<tr><td style="color:#555;font-weight:500;">${row.label}</td>`;
      const vals = valid.map(d => ({ raw: d.stats[row.key], display: row.fn(d.stats) }));
      vals.forEach((v, i) => {
        let extra = "";
        if (numericKeys.includes(row.key)) {
          const nums = vals.map(x => typeof x.raw === 'number' ? x.raw : parseFloat(x.raw)).filter(isFinite);
          if (nums.length > 1) {
            const n = typeof v.raw === 'number' ? v.raw : parseFloat(v.raw);
            if (n === Math.max(...nums)) extra = ' style="background:rgba(46,180,96,0.08);font-weight:600;"';
            else if (n === Math.min(...nums)) extra = ' style="background:rgba(220,80,80,0.07);font-weight:600;"';
          }
        }
        html += `<td${extra}>${escHtml(String(v.display))}</td>`;
      });
      html += '</tr>';
    });
    html += '</tbody></table></div>';
    html += '<div style="margin-top:6px;font-size:10px;color:#aaa;padding:4px 8px;background:#f9fafb;border-radius:5px;border:1px solid #eee;">Green = highest · Red = lowest (numeric stats)</div>';

    if (valid.length === 2) {
      const sA = valid[0].stats, sB = valid[1].stats;
      const cA = colors[0], cB = colors[1];
      const meanDiff = sB.mean - sA.mean;
      const pooledSD = Math.sqrt((sA.sampleVariance + sB.sampleVariance) / 2);
      const cohensD = pooledSD > 0 ? Math.abs(meanDiff) / pooledSD : 0;
      let effectLabel = "negligible";
      if (cohensD >= 0.8) effectLabel = "large";
      else if (cohensD >= 0.5) effectLabel = "medium";
      else if (cohensD >= 0.2) effectLabel = "small";
      html += '<div class="__st-section__">Difference analysis</div>';
      html += '<div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;">';
